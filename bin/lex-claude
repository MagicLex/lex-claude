#!/usr/bin/env bash
# lex-claude. manage global Claude Code config (identity, hook, skills).
set -euo pipefail

REPO_URL="${LEX_CLAUDE_REPO:-https://github.com/MagicLex/lex-claude.git}"
INSTALL_DIR="$HOME/.claude/lex-claude"
CLAUDE_DIR="$HOME/.claude"
SETTINGS="$CLAUDE_DIR/settings.json"
BIN_DIR="$HOME/.local/bin"
BIN_LINK="$BIN_DIR/lex-claude"
BIN_ALIAS="$BIN_DIR/lc"

die() { echo "error: $*" >&2; exit 1; }

reset_managed_tree() {
  # Install dir is a deployed artifact, not a workspace. sync_rules and deploy
  # rewrite tracked files; any drift would block git pull. Discard local mods
  # to tracked files before pulling. Untracked files (.last-update-check, etc)
  # are left alone.
  [ -d "$INSTALL_DIR/.git" ] || return 0
  git -C "$INSTALL_DIR" checkout -- . 2>/dev/null || true
}

auto_update() {
  [ "${LEX_CLAUDE_NO_AUTO_UPDATE:-}" = "1" ] && return 0
  [ -d "$INSTALL_DIR/.git" ] || return 0
  local marker="$INSTALL_DIR/.last-update-check"
  local now last=0 diff
  now=$(date +%s)
  [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
  diff=$((now - last))
  [ "$diff" -lt 86400 ] && return 0
  echo "$now" > "$marker"
  git -C "$INSTALL_DIR" fetch --quiet origin 2>/dev/null || return 0
  local local_sha remote_sha
  local_sha=$(git -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null) || return 0
  remote_sha=$(git -C "$INSTALL_DIR" rev-parse '@{u}' 2>/dev/null) || return 0
  [ "$local_sha" = "$remote_sha" ] && return 0
  echo "lex-claude: newer version on origin. updating..."
  reset_managed_tree
  git -C "$INSTALL_DIR" pull --ff-only --quiet 2>/dev/null || { echo "lex-claude: auto-update failed (non-ff or conflict). run 'lc update' manually" >&2; return 0; }
  deploy >/dev/null
  echo "lex-claude: updated, re-running."
  exec "$INSTALL_DIR/bin/lex-claude" "$@"
}

usage() {
  cat <<EOF
lex-claude. global Claude Code config manager

Usage:
  lex-claude install [--yes]    Bootstrap: clone, symlink CLAUDE.md, wire hook, deploy skills. Prompts before overwriting existing files; --yes / LEX_CLAUDE_YES=1 skips the prompt.
  lex-claude update             Pull latest and re-deploy.
  lex-claude identity                                List identities (active marked *).
  lex-claude identity <name>                         Switch active identity.
  lex-claude identity new --name <n> --desc "<d>"    Create identity (persona + shared rules).
  lex-claude identity new --name <n> --empty         Create identity without shared rules.
  lex-claude rules sync                              Re-inject RULES.md into all managed identities.
  lex-claude github-login [--token TOKEN]            Wire gh + git auth from a GitHub token (env: GITHUB_TOKEN). Prompts if no token and interactive.
  lex-claude doctor             Sanity-check the install.
  lex-claude version            Print install version (commit count + date).
EOF
}

cmd_version() {
  [ -d "$INSTALL_DIR/.git" ] || die "not a git install ($INSTALL_DIR has no .git)"
  local n date
  n=$(git -C "$INSTALL_DIR" rev-list --count HEAD 2>/dev/null) || die "cannot read HEAD"
  date=$(git -C "$INSTALL_DIR" log -1 --format=%cs HEAD 2>/dev/null) || date="?"
  echo "lex-claude v$n ($date)"
}

wire_statusline() {
  local cmd="bash $CLAUDE_DIR/statusline-command.sh"
  if ! command -v jq >/dev/null 2>&1; then
    echo "warn: jq missing. add statusLine manually to $SETTINGS (command: $cmd)"
    return 0
  fi
  [ -f "$SETTINGS" ] || { echo '{}' > "$SETTINGS"; }

  local current
  current=$(jq -r '.statusLine.command // empty' "$SETTINGS" 2>/dev/null || echo "")
  case "$current" in
    *statusline-command.sh*) echo "statusline: wired (kept)"; return 0 ;;
    "") ;;
    *) echo "statusline: custom command in $SETTINGS (kept). to use lex-claude's, set: $cmd"; return 0 ;;
  esac

  local out; out=$(mktemp 2>/dev/null) || out="/tmp/lc-settings-sl.$$"
  if jq --arg cmd "$cmd" '.statusLine = {"type":"command","command":$cmd}' "$SETTINGS" > "$out" \
     && mv "$out" "$SETTINGS"; then
    echo "statusline: wired"
  else
    echo "warn: jq patch failed. statusLine NOT wired."
    rm -f "$out" 2>/dev/null || true
    return 1
  fi
}

wire_hook() {
  local cmd="bash $INSTALL_DIR/hook.sh"
  if ! command -v jq >/dev/null 2>&1; then
    echo "warn: jq missing. add hook manually to $SETTINGS (command: $cmd)"
    return 0
  fi
  mkdir -p "$(dirname "$SETTINGS")" 2>/dev/null || true

  if [ ! -f "$SETTINGS" ]; then
    local tmp; tmp=$(mktemp 2>/dev/null) || tmp="/tmp/lc-settings.$$"
    if ! { echo '{}' > "$tmp" && mv "$tmp" "$SETTINGS"; } 2>/dev/null; then
      echo "warn: cannot write $SETTINGS (open-create blocked by fs?). hook NOT wired."
      echo "diag: $(ls -la "$(dirname "$SETTINGS")" 2>&1 | head -3 | tr '\n' '|')"
      rm -f "$tmp" 2>/dev/null || true
      return 1
    fi
  fi

  local bak="$SETTINGS.bak.$(date +%s)"
  cp "$SETTINGS" "$bak" 2>/dev/null || true

  local out; out=$(mktemp 2>/dev/null) || out="/tmp/lc-settings-out.$$"
  if jq --arg cmd "$cmd" '
    .hooks //= {} |
    .hooks.SessionStart //= [] |
    .hooks.SessionStart = [
      .hooks.SessionStart[]
      | select(all(.hooks[]?; (.command // "") | (test("JeanJean") or test("lex-claude/hook")) | not))
    ] |
    .hooks.SessionStart += [{"hooks":[{"type":"command","command":$cmd}]}]
  ' "$SETTINGS" > "$out" && mv "$out" "$SETTINGS"; then
    echo "hook: wired"
  else
    echo "warn: jq patch failed. hook NOT wired. backup at $bak"
    rm -f "$out" 2>/dev/null || true
    return 1
  fi
}

deploy() {
  mkdir -p "$CLAUDE_DIR/skills" "$BIN_DIR"

  sync_rules

  local target="$CLAUDE_DIR/CLAUDE.md"
  local cur; cur=$(readlink "$target" 2>/dev/null || true)
  if [[ "$cur" == "$INSTALL_DIR/identities/"*.md ]] && [ -e "$cur" ]; then
    echo "identity: $(basename "$cur" .md) (kept)"
  else
    local default_identity=""
    for f in "$INSTALL_DIR"/identities/*.md; do
      [ -e "$f" ] || continue
      default_identity=$(basename "$f" .md)
      break
    done
    [ -n "$default_identity" ] || die "no identities found in $INSTALL_DIR/identities/"
    [ -e "$target" ] && [ ! -L "$target" ] && cp "$target" "$target.bak.$(date +%s)" && echo "backup: $target.bak.*"
    ln -sfn "$INSTALL_DIR/identities/$default_identity.md" "$target"
    echo "identity: $default_identity (linked)"
  fi

  for link in "$CLAUDE_DIR/skills/"*; do
    [ -L "$link" ] || continue
    local target; target=$(readlink "$link")
    [[ "$target" == "$INSTALL_DIR/skills/"* ]] || continue
    [ -e "$target" ] && continue
    rm "$link"
    echo "skill: removed stale $(basename "$link")"
  done

  for skill in "$INSTALL_DIR"/skills/*/; do
    [ -d "$skill" ] || continue
    local name; name=$(basename "$skill")
    ln -sfn "$skill" "$CLAUDE_DIR/skills/$name"
    echo "skill: $name"
  done

  ln -sfn "$INSTALL_DIR/bin/lex-claude" "$BIN_LINK"
  ln -sfn "$INSTALL_DIR/bin/lex-claude" "$BIN_ALIAS"
  echo "cli: $BIN_LINK (alias: lc)"

  local sl_target="$CLAUDE_DIR/statusline-command.sh"
  local sl_src="$INSTALL_DIR/statusline-command.sh"
  if [ -f "$sl_src" ]; then
    if [ -e "$sl_target" ] && [ ! -L "$sl_target" ]; then
      cp "$sl_target" "$sl_target.bak.$(date +%s)"
      echo "backup: $sl_target.bak.*"
    fi
    ln -sfn "$sl_src" "$sl_target"
    echo "statusline: $sl_target"
  fi

  ensure_path_in_rc || true

  wire_hook || echo "note: hook wiring skipped. cli works. run 'lc doctor' to investigate."
  wire_statusline || echo "note: statusline wiring skipped. run 'lc doctor' to investigate."
}

cmd_install() {
  local yes=0
  for arg in "$@"; do
    case "$arg" in --yes|-y) yes=1 ;; esac
  done
  [ "${LEX_CLAUDE_YES:-}" = "1" ] && yes=1

  local needs_prompt=0
  [ -e "$CLAUDE_DIR/CLAUDE.md" ] && [ ! -L "$CLAUDE_DIR/CLAUDE.md" ] && needs_prompt=1
  [ -f "$SETTINGS" ] && needs_prompt=1

  if [ $needs_prompt -eq 1 ] && [ $yes -eq 0 ]; then
    echo "lc install will modify these existing files (backups will be created):"
    [ -e "$CLAUDE_DIR/CLAUDE.md" ] && [ ! -L "$CLAUDE_DIR/CLAUDE.md" ] && echo "  - $CLAUDE_DIR/CLAUDE.md → backup + replace with symlink to managed identity"
    [ -e "$CLAUDE_DIR/statusline-command.sh" ] && [ ! -L "$CLAUDE_DIR/statusline-command.sh" ] && echo "  - $CLAUDE_DIR/statusline-command.sh → backup + replace with symlink to managed script"
    [ -f "$SETTINGS" ] && echo "  - $SETTINGS → backup + jq-patch SessionStart hook + statusLine"
    if [ -t 0 ]; then
      printf "continue? [y/N] "
      local r; read -r r
      case "$r" in y|Y|yes) ;; *) echo "aborted."; exit 0 ;; esac
    else
      die "not a TTY. Pass --yes (or LEX_CLAUDE_YES=1) to confirm."
    fi
  fi

  if [ -d "$INSTALL_DIR/.git" ]; then
    echo "already installed at $INSTALL_DIR. pulling latest"
    reset_managed_tree
    git -C "$INSTALL_DIR" pull --ff-only
  else
    mkdir -p "$(dirname "$INSTALL_DIR")"
    git clone "$REPO_URL" "$INSTALL_DIR"
  fi

  if [ "${LEX_CLAUDE_INSTALL_REEXEC:-}" != "1" ] && [ -x "$INSTALL_DIR/bin/lex-claude" ]; then
    if ! cmp -s "$0" "$INSTALL_DIR/bin/lex-claude" 2>/dev/null; then
      echo "install: re-exec on-disk script (curl CDN may serve stale)"
      LEX_CLAUDE_INSTALL_REEXEC=1 LEX_CLAUDE_YES="${LEX_CLAUDE_YES:-1}" exec "$INSTALL_DIR/bin/lex-claude" install
    fi
  fi

  deploy
  echo "done. open a new Claude Code session to load."
}

cmd_update() {
  [ -d "$INSTALL_DIR/.git" ] || die "not installed. run: lex-claude install"
  reset_managed_tree
  git -C "$INSTALL_DIR" pull --ff-only
  deploy
  echo "updated."
}

sync_rules() {
  [ -f "$INSTALL_DIR/RULES.md" ] || return 0
  local f n=0
  for f in "$INSTALL_DIR"/identities/*.md; do
    [ -f "$f" ] || continue
    grep -q '^<!-- LC_RULES_BEGIN -->' "$f" || continue
    {
      awk '/^<!-- LC_RULES_BEGIN -->/{exit} {print}' "$f"
      printf '<!-- LC_RULES_BEGIN -->\n'
      cat "$INSTALL_DIR/RULES.md"
      printf '<!-- LC_RULES_END -->\n'
      awk 'flag{print} /^<!-- LC_RULES_END -->/{flag=1}' "$f"
    } > "$f.tmp" && mv "$f.tmp" "$f"
    n=$((n+1))
  done
  echo "rules: synced into $n identit$([ $n -eq 1 ] && echo y || echo ies)"
}

identity_new() {
  local name="" desc="" empty=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name|-name) name="${2:-}"; shift 2 ;;
      --desc|-desc) desc="${2:-}"; shift 2 ;;
      --empty|--force-empty) empty=1; shift ;;
      *) die "unknown flag: $1 (expected --name/--desc/--empty)" ;;
    esac
  done
  [ -n "$name" ] || die "missing --name"
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "name must match [a-zA-Z0-9_-]+"
  local file="$INSTALL_DIR/identities/$name.md"
  [ -e "$file" ] && die "identity '$name' already exists at $file"

  if [ $empty -eq 1 ]; then
    {
      printf 'You are %s.' "$name"
      [ -n "$desc" ] && printf ' %s' "$desc"
      printf '\n'
    } > "$file"
    echo "created (empty, no shared rules): $file"
  else
    [ -n "$desc" ] || die "missing --desc (or use --empty)"
    {
      printf 'You are %s. %s\n\n' "$name" "$desc"
      printf '<!-- LC_RULES_BEGIN -->\n'
      cat "$INSTALL_DIR/RULES.md"
      printf '<!-- LC_RULES_END -->\n'
    } > "$file"
    echo "created with shared rules: $file"
  fi
  echo "next:   \$EDITOR $file"
  echo "switch: lc identity $name"

  if [ -d "$INSTALL_DIR/.git" ]; then
    if git -C "$INSTALL_DIR" add "identities/$name.md" \
       && git -C "$INSTALL_DIR" commit -q -m "add identity: $name" 2>/dev/null; then
      if git -C "$INSTALL_DIR" push -q 2>/dev/null; then
        echo "git:    committed + pushed to origin"
      else
        echo "git:    committed locally (push failed. no remote perms? run 'git -C $INSTALL_DIR push' manually, or: lc github-login --token <TOKEN>)"
      fi
    fi
  fi
}

cmd_rules() {
  case "${1:-}" in
    sync) sync_rules ;;
    "") sync_rules ;;
    *) die "unknown rules subcommand: $1 (expected: sync)" ;;
  esac
}

cmd_identity() {
  local target="$CLAUDE_DIR/CLAUDE.md"
  case "${1:-}" in
    "")
      local cur; cur=$(readlink "$target" 2>/dev/null || true)
      for f in "$INSTALL_DIR"/identities/*.md; do
        [ -e "$f" ] || continue
        local n; n=$(basename "$f" .md)
        [ "$cur" = "$f" ] && echo "* $n" || echo "  $n"
      done
      return
      ;;
    new)
      shift; identity_new "$@"
      return
      ;;
  esac
  local src="$INSTALL_DIR/identities/$1.md"
  [ -f "$src" ] || die "identity '$1' not found in $INSTALL_DIR/identities/"
  ln -sfn "$src" "$target"
  echo "switched to: $1"
}

ensure_path_in_rc() {
  case ":$PATH:" in
    *":$BIN_DIR:"*) echo "ok    PATH includes $BIN_DIR"; return 0 ;;
  esac
  local rc=""
  case "$(basename "${SHELL:-}")" in
    zsh)  rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *) echo "warn  unknown shell ($SHELL). add manually: export PATH=\"\$HOME/.local/bin:\$PATH\""; return 1 ;;
  esac
  local line='export PATH="$HOME/.local/bin:$PATH"'
  if [ -f "$rc" ] && grep -Fq "$line" "$rc"; then
    echo "ok    PATH export already in $rc. re-source it: source $rc"
    return 0
  fi
  printf '\n# added by lex-claude\n%s\n' "$line" >> "$rc"
  echo "fix   appended PATH export to $rc. re-source it: source $rc"
}

cmd_github_login() {
  local token=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --token|-t) token="${2:-}"; shift 2 ;;
      *) die "unknown flag: $1 (expected --token)" ;;
    esac
  done

  if [ -z "$token" ]; then
    token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
  fi
  if [ -z "$token" ]; then
    if [ -t 0 ]; then
      printf "github personal access token (input hidden): "
      stty -echo 2>/dev/null || true
      read -r token
      stty echo 2>/dev/null || true
      printf '\n'
    else
      die "no token. pass --token, set GITHUB_TOKEN, or run interactively."
    fi
  fi
  [ -n "$token" ] || die "empty token."

  if command -v gh >/dev/null 2>&1; then
    printf '%s' "$token" | gh auth login --with-token --hostname github.com
    gh auth setup-git
    local user; user=$(gh api user --jq .login 2>/dev/null || echo "?")
    echo "gh: authenticated as $user"
    echo "git: gh credential helper wired for github.com"
  else
    git config --global credential.helper store
    local user
    user=$(curl -fsSL -H "Authorization: token $token" https://api.github.com/user 2>/dev/null \
           | sed -n 's/.*"login": *"\([^"]*\)".*/\1/p' | head -n1)
    [ -n "$user" ] || die "token rejected by github api. check scope/expiry."
    {
      printf 'https://%s:%s@github.com\n' "$user" "$token"
    } > "$HOME/.git-credentials"
    chmod 600 "$HOME/.git-credentials"
    echo "git: stored credentials in ~/.git-credentials as $user"
    echo "note: install gh for richer auth (PRs, issues). brew install gh / apt install gh."
  fi

  local who="${user:-MagicLex}"
  if command -v git >/dev/null 2>&1; then
    [ -z "$(git config --global user.email 2>/dev/null)" ] && \
      git config --global user.email "$who@users.noreply.github.com" && \
      echo "git: set user.email to $who@users.noreply.github.com (override with: git config --global user.email ...)"
    [ -z "$(git config --global user.name 2>/dev/null)" ] && \
      git config --global user.name "$who" && \
      echo "git: set user.name to $who"
  fi
}

cmd_doctor() {
  local ok=1
  if [ -d "$INSTALL_DIR/.git" ]; then
    local n date
    n=$(git -C "$INSTALL_DIR" rev-list --count HEAD 2>/dev/null || echo '?')
    date=$(git -C "$INSTALL_DIR" log -1 --format=%cs HEAD 2>/dev/null || echo '?')
    echo "ok    version v$n ($date)"
  else
    echo "warn  $INSTALL_DIR has no .git. version unknown"
  fi
  if [ -L "$CLAUDE_DIR/CLAUDE.md" ] && [ -e "$CLAUDE_DIR/CLAUDE.md" ]; then
    echo "ok    CLAUDE.md → $(readlink "$CLAUDE_DIR/CLAUDE.md")"
  else
    echo "fail  CLAUDE.md not linked"; ok=0
  fi
  for skill in "$INSTALL_DIR"/skills/*/; do
    [ -d "$skill" ] || continue
    local name; name=$(basename "$skill")
    [ -L "$CLAUDE_DIR/skills/$name" ] && echo "ok    skill $name" || { echo "fail  skill $name"; ok=0; }
  done
  grep -q "lex-claude/hook" "$SETTINGS" 2>/dev/null && echo "ok    hook wired" || { echo "fail  hook not wired"; ok=0; }
  if [ -L "$CLAUDE_DIR/statusline-command.sh" ] && [ -e "$CLAUDE_DIR/statusline-command.sh" ]; then
    echo "ok    statusline → $(readlink "$CLAUDE_DIR/statusline-command.sh")"
  else
    echo "warn  statusline not symlinked"
  fi
  grep -q "statusline-command.sh" "$SETTINGS" 2>/dev/null && echo "ok    statusline wired" || echo "warn  statusline not wired in $SETTINGS"
  [ -L "$BIN_LINK" ] && echo "ok    cli ($BIN_LINK)" || { echo "fail  cli not symlinked"; ok=0; }
  [ -L "$BIN_ALIAS" ] && echo "ok    alias lc → lex-claude" || { echo "fail  alias 'lc' not symlinked"; ok=0; }
  ensure_path_in_rc || ok=0
  [ $ok -eq 1 ] && echo "all good." || { echo "issues. run: lex-claude install"; exit 1; }
}

case "${1:-}" in
  install|update|rules|version|github-login|-v|--version|-h|-help|--help|help|"") ;;
  *) auto_update "$@" ;;
esac

case "${1:-}" in
  install)      shift; cmd_install "$@" ;;
  update)       shift; cmd_update "$@" ;;
  identity)     shift; cmd_identity "$@" ;;
  rules)        shift; cmd_rules "$@" ;;
  github-login) shift; cmd_github_login "$@" ;;
  doctor)       shift; cmd_doctor "$@" ;;
  version|-v|--version) cmd_version ;;
  -h|-help|--help|help|"") usage ;;
  *) usage; exit 1 ;;
esac
