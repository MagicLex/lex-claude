#!/usr/bin/env bash
# hopsdev. point the local hops CLI at a hopsworks-api branch.
# Two modes:
#   default  clone the branch, editable install (uv pip install -e), relink skills
#   --quick  no clone: uv pip install --force-reinstall git+...@branch
set -euo pipefail

DEFAULT_REPO="${HOPSDEV_REPO:-MagicLex/hopsworks-api}"
CLONE_BASE="${HOPSDEV_HOME:-${TMPDIR:-/tmp}/hopsdev}"
SKILLS_DIR="$HOME/.claude/skills"
WORKSPACES_REPO="${WORKSPACES_REPO:-git@github.com:logicalclocks/workspaces.git}"

die() { echo "error: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found in PATH"; }

usage() {
  cat <<EOF
hopsdev. point your local hops CLI at a hopsworks-api branch.

Usage:
  hopsdev <branch>                 clone $DEFAULT_REPO@<branch>, editable install, relink skills
  hopsdev <owner/repo>@<branch>    same, from a different fork
  hopsdev <git-url>@<branch>       same, from a full git URL (https or ssh)
  hopsdev --quick <spec>           skip clone + skills: uv pip install --force-reinstall git+...
  hopsdev --status                 show where 'hops' resolves now
  hopsdev init [dir]               clone logicalclocks/workspaces into [dir] (default ./workspaces), then print next steps

Examples:
  hopsdev HFRONT-1543-fti-run-fixes
  hopsdev someone/hopsworks-api@my-branch
  hopsdev --quick HFRONT-1543-fti-run-fixes
  hopsdev init

Env:
  HOPSDEV_REPO     default repo as owner/name (default: $DEFAULT_REPO)
  HOPSDEV_HOME     clone base dir (default: \$TMPDIR/hopsdev)
  WORKSPACES_REPO  workspaces repo url (default: $WORKSPACES_REPO)
EOF
}

# clone (or refresh) the workspaces repo so you don't have to hunt the url.
# does NOT run its scripts/init.sh: that one is interactive and clones many
# repos. just bring the repo, then print the README's next steps.
ws_init() {
  need git
  local dest="${1:-$PWD/workspaces}"
  if [ -d "$dest/.git" ]; then
    echo "hopsdev init: workspaces already at $dest (pull)"
    git -C "$dest" pull --ff-only --quiet || echo "note: pull skipped (non-ff or offline)"
  else
    echo "hopsdev init: clone $WORKSPACES_REPO -> $dest"
    git clone --quiet "$WORKSPACES_REPO" "$dest"
  fi
  cat <<EOF

next (per the repo README):
  cd $dest
  ./scripts/init.sh                 # build base/ (idempotent, interactive)
  ./scripts/init_workspace.sh <pr>  # scaffold a workspace, then: cd <pr> && claude
EOF
}

# owner/name | bare-name | url  ->  clonable git url
repo_url() {
  case "$1" in
    *://*|git@*) echo "$1" ;;
    */*)         echo "https://github.com/$1" ;;
    *)           echo "https://github.com/${DEFAULT_REPO%/*}/$1" ;;
  esac
}
repo_name() { local r="${1%.git}"; echo "${r##*/}"; }

verify() {
  local where; where=$(command -v hops 2>/dev/null || echo "not found")
  echo "hops -> $where"
}

# wipe every skill symlink EXCEPT lex-claude's own and my-skills, then relink
# from $1. wipe-then-relink means a skill deleted from the branch disappears,
# and stale links from older clones (this base or old /tmp/apiNNN dirs) go too.
LC_SKILLS="$HOME/.claude/lex-claude/skills"
relink_skills() {
  local clone="$1" link tgt d n=0
  [ -d "$SKILLS_DIR" ] || return 0
  for link in "$SKILLS_DIR"/*; do
    [ -L "$link" ] || continue
    [ "$(basename "$link")" = "my-skills" ] && continue
    tgt=$(readlink "$link")
    case "$tgt" in "$LC_SKILLS"/*) continue ;; esac  # keep lex-claude's own skills
    rm -f "$link"                                     # stale hops / external skill -> drop
  done
  if [ ! -d "$clone/skills" ]; then
    echo "skills: none in clone"
    return 0
  fi
  for d in "$clone"/skills/*/*/; do
    [ -f "$d/SKILL.md" ] || continue
    ln -sfn "$d" "$SKILLS_DIR/$(basename "$d")"
    n=$((n + 1))
  done
  echo "skills: relinked $n from clone"
}

run() {
  local quick=0 spec=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --quick|-q) quick=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *)  [ -z "$spec" ] || die "too many args (got '$spec' then '$1')"; spec="$1"; shift ;;
    esac
  done
  [ -n "$spec" ] || { usage; exit 1; }

  need uv
  need git

  local repo branch
  case "$spec" in
    *@*) repo="${spec%@*}"; branch="${spec##*@}" ;;
    *)   repo="$DEFAULT_REPO"; branch="$spec" ;;
  esac
  local url name
  url=$(repo_url "$repo")
  name=$(repo_name "$url")

  if [ "$quick" -eq 1 ]; then
    echo "hopsdev: force-reinstall $name@$branch (no clone)"
    uv pip install --force-reinstall "hopsworks[python]@git+${url}@${branch}#subdirectory=python"
    verify
    echo "note: --quick skips skill relink. drop --quick to relink skills."
    return 0
  fi

  local dest="$CLONE_BASE/${name}@${branch}"
  mkdir -p "$CLONE_BASE"
  if [ -d "$dest/.git" ]; then
    echo "hopsdev: refresh $dest"
    git -C "$dest" fetch --quiet origin "$branch"
    git -C "$dest" checkout --quiet "$branch"
    git -C "$dest" reset --hard --quiet "origin/$branch"
  else
    rm -rf "$dest"
    echo "hopsdev: clone $url@$branch"
    git clone --quiet -b "$branch" "$url" "$dest"
  fi

  echo "hopsdev: editable install $dest/python"
  uv pip install -e "$dest/python"

  relink_skills "$dest"
  verify
}

case "${1:-}" in
  -h|--help|help|"") usage ;;
  --status)          verify ;;
  init)              shift; ws_init "$@" ;;
  *)                 run "$@" ;;
esac
